{
  "name": "fluxionjs-v2",
  "version": "2.0.0",
  "description": "High-performance 2D/3D TypeScript game engine with Tauri editor — inspired by Nuake, LumixEngine & s&box",
  "license": "MIT",
  "author": "",
  "keywords": [
    "game-engine",
    "typescript",
    "three.js",
    "tauri",
    "ecs",
    "webgpu",
    "pbr",
    "physics"
  ],
  "scripts": {
    "build": "node --max-old-space-size=4096 ./node_modules/webpack/bin/webpack.js --config webpack.config.js --env production",
    "build:watch": "node --max-old-space-size=4096 ./node_modules/webpack/bin/webpack.js --config webpack.config.js --watch",
    "build:tauri": "node --max-old-space-size=4096 ./node_modules/webpack/bin/webpack.js --config webpack.config.js --env production",
    "build:tauri:watch": "node --max-old-space-size=4096 ./node_modules/webpack/bin/webpack.js --config webpack.config.js --watch",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:wasm-csg": "wasm-pack build fluxion-core --target web --out-dir pkg --features wasm",
    "build:wasm": "wasm-pack build fluxion-core --target web --out-dir pkg --features wasm",
    "lint": "eslint src/ editor/",
    "dev:full": "npm install && npm run build:wasm && npm run tauri:dev"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "^12.10.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.0",
    "html-webpack-plugin": "^5.6.0",
    "lucide-react": "^1.6.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "style-loader": "^4.0.0",
    "three": "^0.170.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.6.0",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.170.0"
  }
}
