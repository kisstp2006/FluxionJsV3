{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "FluxionJS V3 Editor",
  "version": "2.0.0",
  "identifier": "com.fluxionjs.editor",
  "build": {
    "beforeDevCommand": "npm run build:tauri:watch",
    "beforeBuildCommand": "npm run build:tauri",
    "frontendDist": "../dist/editor"
  },
  "app": {
    "windows": [
      {
        "title": "FluxionJS V3 Editor",
        "width": 1600,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "publisher": "FluxionJS",
    "homepage": "https://github.com/fluxionjs/fluxionjs-v3",
    "resources": [],
    "externalBin": [],
    "copyright": "Copyright © 2024 FluxionJS",
    "category": "DeveloperTool",
    "shortDescription": "FluxionJS Game Engine Editor",
    "longDescription": "High-performance 2D/3D TypeScript game engine with integrated editor",
    "windows": {
      "wix": null,
      "nsis": null,
      "signCommand": null
    }
  },
  "plugins": {
    "shell": {}
  }
}
