-- $CLS

-- ── Inspector properties ─────────────────────────────────────
--- Drag a Camera entity here in the Inspector.
camera     = EntityRef("Camera")

--- Mouse look sensitivity (degrees per pixel).
sensitivity = 0.15
--- Maximum look-up / look-down angle in degrees.
maxPitch    = 85.0
--- Height offset from the character pivot to the camera eye.
headHeight  = 1.6
--- Maximum mouse delta per frame to prevent camera jumps.
maxMouseDelta = 100.0

-- ── Private state ────────────────────────────────────────────
local _yaw   = 0
local _pitch = 0

function start()
    local tf = self.transform
    if tf then _yaw = tf.rotation.y * Mathf.Rad2Deg end

    -- Auto-detect camera child if no EntityRef was assigned in the Inspector
    if camera.entity == nil then
        local camChild = self.findChildWithComponent("Camera")
        if camChild ~= nil then
            camera.entity = camChild
            self.log("FPS: camera child auto-detected (entity " .. tostring(camChild) .. ")")
        else
            self.log("FPS: no Camera child found — drag a Camera entity into the \"camera\" slot, or add a Camera component to a child entity.")
        end
    end

    self.Input.lockPointer()
    self.log("FPS Character ready — click viewport to capture mouse, Escape to release.")
end

function update(dt)
    if self.Input.isMousePressed(0) and not self.Input.isPointerLocked() then
        self.Input.lockPointer()
    end

    -- ── Controls overlay ─────────────────────────────────────
    if not self.Input.isPointerLocked() then
        self.Debug.drawText(Vec2(8, 8), "Left-click to capture mouse", "#94a3b8", 12)
    else
        self.Debug.drawText(Vec2(8, 8),  "WASD — move   Space — jump", "#94a3b8", 12)
        self.Debug.drawText(Vec2(8, 22), "Shift — sprint   Ctrl/C — crouch   Esc — release", "#94a3b8", 12)
        
        -- Debug info: show slope state
        local physics = self.getComponent("CharacterController")
        if physics and physics._isOnSteepSlope then
            self.Debug.drawText(Vec2(8, 36), "⚠ Steep slope detected", "#f87171", 12)
        end
    end

    if not self.Input.isPointerLocked() then return end

    -- ── Mouse look ───────────────────────────────────────────
    -- Clamp mouse delta to prevent camera jumps from large delta values
    local md = self.Input.mouseDelta
    local clampedDeltaX = Mathf.clamp(md.x, -maxMouseDelta, maxMouseDelta)
    local clampedDeltaY = Mathf.clamp(md.y, -maxMouseDelta, maxMouseDelta)
    
    _yaw   = _yaw   - clampedDeltaX * sensitivity
    _pitch = _pitch - clampedDeltaY * sensitivity
    _pitch = Mathf.clamp(_pitch, -maxPitch, maxPitch)

    -- Yaw applied to the character body (horizontal rotation)
    local charTf = self.transform
    if charTf then
        charTf.rotation.set(0, _yaw * Mathf.Deg2Rad, 0, "YXZ")
    end

    -- Pitch applied to the camera child (vertical rotation)
    if camera.entity ~= nil then
        local camTf = self.getComponentOf(camera.entity, "Transform")
        if camTf then
            camTf.rotation.set(_pitch * Mathf.Deg2Rad, 0, 0, "YXZ")
        end
    end

    -- ── Sprint / crouch ──────────────────────────────────────
    local sprint = self.Input.isKeyDown("ShiftLeft") or self.Input.isKeyDown("ShiftRight")
    self.Physics.setRunning(sprint)
    local crouch = self.Input.isKeyDown("ControlLeft") or self.Input.isKeyDown("KeyC")
    self.Physics.crouch(crouch)
end

function fixedUpdate(dt)
    local h = self.Input.getAxis("KeyA", "KeyD")
    local v = self.Input.getAxis("KeyS", "KeyW")
    self.Physics.move(h, -v)

    if self.Input.isKeyPressed("Space") then self.Physics.jump() end

    -- Keep camera positioned at head height above character pivot
    local charTf = self.transform
    if charTf and camera.entity ~= nil then
        local camTf = self.getComponentOf(camera.entity, "Transform")
        if camTf then
            -- Check if camera is a child of the character
            local isChildCamera = self._ecs and self._ecs.getParent and self._ecs.getParent(camera.entity) == self.entity
            if isChildCamera then
                -- Child camera: use local positioning
                camTf.position.set(0, headHeight, 0)
            else
                -- Inspector-assigned camera: use world positioning
                camTf.position.set(
                    charTf.position.x,
                    charTf.position.y + headHeight,
                    charTf.position.z
                )
            end
        end
    end
end

function onDestroy()
    if self.Input.isPointerLocked() then self.Input.unlockPointer() end
end
