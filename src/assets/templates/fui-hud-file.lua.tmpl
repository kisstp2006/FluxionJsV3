-- $CLS
-- Loads a .fui file (assigned in the Inspector) and updates labels each frame.

fuiFile = FuiRef()

local _ready = false

function start()
    if not fuiFile.isValid then
        self.log("$CLS: assign a .fui file in the Inspector", "warn")
        return
    end

    self.ui.onButtonClick("close_btn", function()
        self.ui.hide()
    end)

    _ready = true
    self.log("$CLS: HUD ready")
end

function update(dt)
    if not _ready then return end

    local fps = dt > 0 and math.floor(1.0 / dt) or 0
    self.ui.setText("fps_label",  "FPS: " .. tostring(fps))
    self.ui.setText("time_label", "Time: " .. string.format("%.1f", self.Time.elapsed))
end
