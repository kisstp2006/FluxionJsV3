-- $CLS
-- Assign entities in the Inspector via the entity pickers below
cameraEntity = EntityRef()
targetEntity  = EntityRef()
rtWidth       = 512
rtHeight      = 512
mapSlot       = "map"

local _mat   = nil
local _ready = false

function start()
    -- EntityRef() resolves to a numeric entity ID (-1 = unassigned)
    if cameraEntity < 0 then
        self.warn("[RenderToTexture] cameraEntity not assigned in Inspector")
        return
    end
    if targetEntity < 0 then
        self.warn("[RenderToTexture] targetEntity not assigned in Inspector")
        return
    end

    self.cam.enableRenderToTexture(cameraEntity, rtWidth, rtHeight)

    _mat = self.mat.getFrom(targetEntity)
    if not _mat then
        self.warn("[RenderToTexture] Target has no MeshRenderer material")
        return
    end

    _ready = true
end

function update(dt)
    if not _ready then return end
    if cameraEntity < 0 then return end

    local tex = self.cam.getTexture(cameraEntity)
    if not tex then return end

    self.mat.setTexture(_mat, mapSlot, tex)
end

function onDestroy()
    if cameraEntity >= 0 then
        self.cam.disableRenderToTexture(cameraEntity)
    end
    _mat   = nil
    _ready = false
end
